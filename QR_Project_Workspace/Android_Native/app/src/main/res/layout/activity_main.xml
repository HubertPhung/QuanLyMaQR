<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/qr_background">

    <!-- Container for Fragments -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/qr_card_stroke" />

    <!-- Bottom Navigation Bar (4 tabs) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/qr_background"
        android:orientation="horizontal">

        <!-- Tab 0: Trang chủ -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/qr_mint" />
            <TextView
                android:id="@+id/labelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Trang chủ"
                android:textColor="@color/qr_mint"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 1: Quét mã -->
        <LinearLayout
            android:id="@+id/tabScan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iconScan"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_scan"
                app:tint="@color/qr_muted" />
            <TextView
                android:id="@+id/labelScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Quét mã"
                android:textColor="@color/qr_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 2: Tạo mã -->
        <LinearLayout
            android:id="@+id/tabGenerate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iconGenerate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_generate"
                app:tint="@color/qr_muted" />
            <TextView
                android:id="@+id/labelGenerate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tạo mã"
                android:textColor="@color/qr_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 3: Lịch sử -->
        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iconHistory"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_history"
                app:tint="@color/qr_muted" />
            <TextView
                android:id="@+id/labelHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Lịch sử"
                android:textColor="@color/qr_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
