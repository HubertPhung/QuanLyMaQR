<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QRStudio" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorAccent">#23EFC2</item>
        <item name="android:statusBarColor">#070E16</item>
        <item name="android:navigationBarColor">#070E16</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AlertDialogDark" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#1C1C1E</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColor">#F8FAFC</item>
        <item name="colorAccent">#00F0FF</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertButtonPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertButtonNegative</item>
    </style>

    <style name="AlertButtonPositive" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FF6B6B</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AlertButtonNegative" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#A1A1AA</item>
    </style>
</resources>

